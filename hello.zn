#foreign("stdio.h") printf(fmt string, args ..any) u32
#foreign("!raylib.h") InitWindow(width u32, height u32, title string) void
#foreign("!raylib.h") SetTargetFPS(fps u32) void
#foreign("!raylib.h") WindowShouldClose() bool
#foreign("!raylib.h") BeginDrawing() void
#foreign("!raylib.h") EndDrawing() void
#foreign("!raylib.h") ClearBackground(color u32) void
#foreign("!raylib.h") DrawText(text string, x i32, y i32, size i32, color u32) void
#foreign("!raylib.h") DrawRectangle(x i32, y i32, w i32, h i32, color u32) void
#foreign("!raylib.h") CloseWindow() void
#foreign("!raylib.h") GetColor() any
#foreign("!raylib.h") SetTraceLogLevel(level u32) void
#foreign("!raylib.h") IsMouseButtonDown(button u32) bool
#foreign("!raylib.h") GetMouseY() u32

main() void {
	i u32 = 0
	for i < 10 {
		printf("fib(%d) = %d\n", i, fib(i))
		i = i + 1
	}

	_WARNING u32 = 4
	_BLACK u32 = 255
	_MAGENTA u32 = 4278255615
	_LEFT u32 = 0

	SetTraceLogLevel(_WARNING)
	InitWindow(800, 600, "raylib in zeno!")
	SetTargetFPS(60)

	y0 string = 300

	bx i32 = 700
	by i32 = 200
	bvx i32 = -5
	bvy i32 = -5

	for !WindowShouldClose() {
		y0 = GetMouseY()

		if bx < 32 {
			bx = 32
			bvx = 5
		}

		if by < 8 {
			by = 8
			bvy = 5
		}

		if bx > 800-32 {
			bx = 800-32
			bvx = -5
		}

		if by > 600 {
			by = 600
			bvy = -5
		}

		bx = bx + bvx
		by = by + bvy

		BeginDrawing()
		ClearBackground(GetColor(_MAGENTA))
		DrawText("hello B)", 0, 0, 20, GetColor(_BLACK))
		DrawRectangle(32, y0-24, 16, 48, GetColor(_BLACK))
		DrawRectangle(800-32, by-24, 16, 48, GetColor(_BLACK))
		DrawCircle(bx, by, 8, GetColor(_BLACK))
		EndDrawing()
	}

	CloseWindow()
}

fib(n u32) u32 {
	if n < 2 {
		return n
	}

	return fib(n - 1) + fib(n - 2)
}
